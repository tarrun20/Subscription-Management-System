generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum ProductType {
  SOFTWARE
  SERVICE
  HARDWARE
  CONSUMABLE
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

enum BillingFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum PlanStatus {
  ACTIVE
  ARCHIVED
}

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  CONVERTED
  REJECTED
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}

enum PaymentTerms {
  IMMEDIATE
  NET_15
  NET_30
  NET_60
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum DiscountTarget {
  ALL
  PRODUCT
  PLAN
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CARD
  OTHER
}

model User {
  id                   String            @id @default(uuid())
  email                String            @unique
  passwordHash         String
  name                 String
  role                 Role              @default(CUSTOMER)
  phone                String?
  resetToken           String?
  resetTokenExpiresAt  DateTime?
  customerProfile      CustomerProfile?
  staffProfile         StaffProfile?
  auditLogs            AuditLog[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([email])
  @@index([role])
}

model CustomerProfile {
  id             String         @id @default(uuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName    String?
  taxNumber      String?
  billingAddress String?
  city           String?
  state          String?
  country        String?        @default("India")
  zipCode        String?
  quotations     Quotation[]
  subscriptions  Subscription[]
  invoices       Invoice[]
  payments       Payment[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId])
  @@index([companyName])
}

model StaffProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode String   @unique
  department   String?
  designation  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id               String            @id @default(uuid())
  name             String
  type             ProductType       @default(SOFTWARE)
  salesPrice       Float
  costPrice        Float
  description      String?
  status           ProductStatus     @default(ACTIVE)
  variants         ProductVariant[]
  planProducts     PlanProduct[]
  quotationLines   QuotationLine[]
  subscriptionLines SubscriptionLine[]
  invoiceLines     InvoiceLine[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status])
  @@index([name])
}

model ProductVariant {
  id                String            @id @default(uuid())
  productId         String
  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantName       String
  priceAdjustment   Float             @default(0.0)
  sku               String?
  quotationLines    QuotationLine[]
  subscriptionLines SubscriptionLine[]
  invoiceLines      InvoiceLine[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([productId])
}

model SubscriptionPlan {
  id                 String             @id @default(uuid())
  name               String
  description        String?
  price              Float
  billingFrequency   BillingFrequency   @default(MONTHLY)
  minimumQuantity    Int                @default(1)
  availableFrom      DateTime?
  availableUntil     DateTime?
  autoCloseOnExpiry  Boolean            @default(false)
  allowEarlyClosure  Boolean            @default(true)
  allowPause         Boolean            @default(true)
  allowRenewal       Boolean            @default(true)
  status             PlanStatus         @default(ACTIVE)
  planProducts       PlanProduct[]
  quotationTemplates QuotationTemplate[]
  quotations         Quotation[]
  subscriptions      Subscription[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([status])
  @@index([billingFrequency])
}

model PlanProduct {
  id                 String           @id @default(uuid())
  planId             String
  plan               SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  productId          String
  product            Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  isIncludedDefault  Boolean          @default(true)

  @@unique([planId, productId])
}

model TaxRule {
  id        String   @id @default(uuid())
  name      String
  rate      Float    // e.g. 18.0 for 18%
  isDefault Boolean  @default(false)
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DiscountRule {
  id                String         @id @default(uuid())
  name              String
  code              String         @unique
  type              DiscountType   @default(PERCENTAGE)
  value             Float          // percentage or fixed amount
  minPurchaseAmount Float          @default(0.0)
  minQuantity       Int            @default(1)
  targetType        DiscountTarget @default(ALL)
  targetId          String?        // specific productId or planId if targetType != ALL
  startDate         DateTime?
  endDate           DateTime?
  maxUsageLimit     Int?
  currentUsageCount Int            @default(0)
  status            Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([code])
  @@index([status])
}

model QuotationTemplate {
  id           String           @id @default(uuid())
  name         String
  planId       String?
  plan         SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  validityDays Int              @default(30)
  notes        String?
  quotations   Quotation[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model Quotation {
  id              String             @id @default(uuid())
  quotationNumber String             @unique
  customerId      String
  customer        CustomerProfile    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  templateId      String?
  template        QuotationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  planId          String?
  plan            SubscriptionPlan?  @relation(fields: [planId], references: [id], onDelete: SetNull)
  status          QuotationStatus    @default(DRAFT)
  validUntil      DateTime
  subtotal        Float              @default(0.0)
  taxAmount       Float              @default(0.0)
  discountAmount  Float              @default(0.0)
  totalAmount     Float              @default(0.0)
  notes           String?
  lines           QuotationLine[]
  subscription    Subscription?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([quotationNumber])
  @@index([customerId])
  @@index([status])
}

model QuotationLine {
  id          String          @id @default(uuid())
  quotationId String
  quotation   Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity    Int             @default(1)
  unitPrice   Float
  taxRate     Float           @default(0.0)
  discount    Float           @default(0.0)
  lineTotal   Float
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([quotationId])
}

model Subscription {
  id                 String             @id @default(uuid())
  subscriptionNumber String             @unique
  customerId         String
  customer           CustomerProfile    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  planId             String
  plan               SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  quotationId        String?            @unique
  quotation          Quotation?         @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  status             SubscriptionStatus @default(DRAFT)
  startDate          DateTime           @default(now())
  expiryDate         DateTime
  nextBillingDate    DateTime
  paymentTerms       PaymentTerms       @default(IMMEDIATE)
  subtotal           Float              @default(0.0)
  taxAmount          Float              @default(0.0)
  discountAmount     Float              @default(0.0)
  totalAmount        Float              @default(0.0)
  earlyClosedAt      DateTime?
  pausedAt           DateTime?
  lines              SubscriptionLine[]
  invoices           Invoice[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([subscriptionNumber])
  @@index([customerId])
  @@index([planId])
  @@index([status])
  @@index([nextBillingDate])
}

model SubscriptionLine {
  id             String          @id @default(uuid())
  subscriptionId String
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity       Int             @default(1)
  unitPrice      Float
  taxRate        Float           @default(0.0)
  discount       Float           @default(0.0)
  lineTotal      Float
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([subscriptionId])
}

model Invoice {
  id                 String          @id @default(uuid())
  invoiceNumber      String          @unique
  subscriptionId     String?
  subscription       Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  customerId         String
  customer           CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status             InvoiceStatus   @default(DRAFT)
  invoiceDate        DateTime        @default(now())
  dueDate            DateTime
  subtotal           Float           @default(0.0)
  taxAmount          Float           @default(0.0)
  discountAmount     Float           @default(0.0)
  totalAmount        Float           @default(0.0)
  paidAmount         Float           @default(0.0)
  outstandingBalance Float           @default(0.0)
  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?
  notes              String?
  lines              InvoiceLine[]
  payments           Payment[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([invoiceNumber])
  @@index([subscriptionId])
  @@index([customerId])
  @@index([status])
  @@index([dueDate])
}

model InvoiceLine {
  id          String          @id @default(uuid())
  invoiceId   String
  invoice     Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  description String
  quantity    Int             @default(1)
  unitPrice   Float
  taxRate     Float           @default(0.0)
  discount    Float           @default(0.0)
  lineTotal   Float
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([invoiceId])
}

model Payment {
  id            String        @id @default(uuid())
  paymentNumber String        @unique
  invoiceId     String
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  customerId    String
  customer      CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount        Float
  paymentMethod PaymentMethod @default(BANK_TRANSFER)
  paymentDate   DateTime      @default(now())
  transactionRef String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([paymentNumber])
  @@index([invoiceId])
  @@index([customerId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
}
